# =============================================================================
# Batchtool / OpenCirt – .gitattributes
# Ensures consistent line endings across Windows and Linux
# =============================================================================

# Default: auto-detect, normalize to LF in repo
* text=auto eol=lf

# Force LF for source code
*.cpp text eol=lf
*.h text eol=lf
*.hpp text eol=lf
*.cmake text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.lsp text eol=lf
*.csv text eol=lf
*.json text eol=lf
*.xml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Force CRLF for Windows-only files
*.bat text eol=crlf
*.cmd text eol=crlf
*.sln text eol=crlf
*.vcxproj text eol=crlf

# Binary files – no conversion, no diff
*.brx binary
*.dll binary
*.exe binary
*.lib binary
*.pdb binary
*.png binary
*.jpg binary
*.gif binary
*.ico binary
*.pdf binary
*.dwg binary
*.dxf binary
*.zip binary
