# =============================================================================
# Batchtool / OpenCirt – .editorconfig
# https://editorconfig.org
# =============================================================================

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# C++ source
[*.{cpp,h,hpp}]
indent_size = 4

# CMake
[CMakeLists.txt]
indent_size = 4

[*.cmake]
indent_size = 4

# LISP scripts
[*.lsp]
indent_size = 2

# Batch / CMD
[*.{bat,cmd}]
end_of_line = crlf

# Markdown
[*.md]
trim_trailing_whitespace = false

# CSV / TSV
[*.{csv,tsv}]
insert_final_newline = false
trim_trailing_whitespace = false

# YAML
[*.{yml,yaml}]
indent_size = 2
